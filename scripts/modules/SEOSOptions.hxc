import funkin.modding.module.Module;
import Std;
import funkin.ui.options.OptionsState;
import flixel.FlxG;
import funkin.play.PlayState;
import Type;
import funkin.util.ReflectUtil;
import funkin.util.Constants;
import funkin.play.character.CharacterDataParser;
import funkin.play.character.BaseCharacter;
import funkin.ui.PixelatedIcon;
import funkin.ui.freeplay.SongMenuItem;
import funkin.ui.freeplay.FreeplayState;
import funkin.PlayerSettings;
import flixel.util.FlxTimer;
import funkin.save.Save;

class SEOSOptions extends Module
{
    /* This should've been done in the first place, instead of having them all separate.
	    * This module is used to handle the Smoke 'Em Out Struggle options, such as:
	    * - Freeplay Icon Sets
		* - OG Style (Mimics pre-0.3.0 Funkin' by removing Note Splashes and Hold Note Covers/Splashes)
		* - Cinematic Events (Top and bottom black borders, Used in Release Erect)
	*/

	public var char:BaseCharacter;
	public var cinematics:Bool = true;
	public var enabled:Bool = true;
	var curSelected:Int;

	public function new(){
		super("SEOSOptions", 1);

		// Initialize mod options with default values if they don't exist
		if(Save.instance.modOptions["cinematics"] == null) Save.instance.modOptions["cinematics"] = true;

		cinematics = Save.instance.modOptions["cinematics"];
	}

	public var inOptions:Bool = false;

	override function onStateChangeEnd(event){
		super.onStateChangeEnd(event);
		inOptions = false;
		if(Std.isOfType(event.targetState, OptionsState)){
			var prefs = event.targetState.optionsCodex.pages.get("preferences");
			inOptions = true;

			prefs.createPrefItemCheckbox("Cinematics", "Adds a letterboxing effect during certain sections of songs. \nPrimarily used in Release Erect.", function(value) {
				Save.instance.modOptions["cinematics"] = value;
				cinematics = value;
				Save.instance.flush();
			}, Save.instance.modOptions["cinematics"]);
		}
	}
}